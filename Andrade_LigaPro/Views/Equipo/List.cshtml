@model IEnumerable<Andrade_LigaPro.Models.equipo>

@{
    ViewData["Title"] = "Tabla de Posiciones";
}

<h1>Tabla de Posiciones</h1>


<div class="tablaEstilo">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.partidosGanados)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.partidosJugados)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.partidosPerdidos)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.partidosEmpatados)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Puntos)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                        <img src="~/images/@($"{item.Id}.png")" alt="Logo @item.Nombre" style="height: 50px;" /> <!-- Linea de Codigo para remplazar los id de cada equipo con su respectivo logo -->

                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.partidosGanados)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.partidosJugados)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.partidosPerdidos)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.partidosEmpatados)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Puntos)
                </td>

                <!-- La sintaxis del boton recibi ayuda de gpt para poder hacer que con el click llamen al modal y el modelo del boton es de bootstrap -->  
                
                <td>
                    <button type="button" class="botonTabla " data-bs-toggle="modal" data-bs-target="#equipoModal">Actualizar </button>

                </td>

                <td>
                        <a asp-action="Descripcion" asp-route-id="@item.Id" class="botonTabla">Descripción</a>  <!-- Redirige a la nueva vista de la Descripcion -->
                </td>
                
            </tr>
    }
        </tbody>
    </table>
</div>


<!-- Modal y formulario hecho con base a un modelo de bootstrap -->
<!-- Ventana Emergente para la Actualizacion de la tabla -->


<div class="modal fade" id="equipoModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Actualizar información del equipo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Edit" asp-controller="equipo" method="post">
                    <div class="mb-3">
                        <!-- Menu desplegable de seleccion con bootstrap -->
                        <label class="form-label">Seleccionar equipo</label>
                        <select class="form-select" name="Id" required>
                            <option selected disabled>-- Selecciona un equipo --</option> 
                            <option value="1">Liga de Quito</option>
                            <option value="2">Barcelona Sporting Club</option>
                            <option value="3">Universidad Católica</option>
                            <option value="4">Independiente del Valle</option>
                            <option value="5">Cuniburo Futbol Club</option>
                            <option value="6">Libertad Futbol Club</option>
                            <option value="7">Orense</option>
                            <option value="8">Mushuc Runa</option>
                            <option value="9">Aucas</option>
                            <option value="10">Macara</option>
                            <option value="11">Deportivo Cuenca</option>
                            <option value="12">Manta</option>
                            <option value="13">Tecnico Universitario</option>
                            <option value="14">Delfin</option>
                            <option value="15">Emelec</option>
                            <option value="16">El Nacional</option>
                            
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Partidos Jugados</label>
                        <input type="number" name="partidosJugados" class="form-control" max="32" />
                        
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Partidos Ganados</label>
                        <input type="number" name="partidosGanados" class="form-control" max="32" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Partidos Empatados</label>
                        <input type="number" name="partidosEmpatados" class="form-control" max="32" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Partidos Perdidos</label>
                        <input type="number" name="partidosPerdidos" class="form-control" max="32" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>  <!--Tuve que cambiar el footer dentro del formulario y ubicar el tipo submit ya que lo prestablecido en el bootstrap con el modal no me estaba funcionando -->
                    </div>
                </form>
            </div>
            
        </div>
    </div>
</div>

